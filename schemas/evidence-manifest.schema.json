{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forenx.local/schemas/evidence-manifest.schema.json",
  "title": "ForenX Evidence Package Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "package_id",
    "case_id",
    "acquisition_id",
    "acquisition_method",
    "forenx_version",
    "created_at_utc",
    "artifacts"
  ],
  "properties": {
    "manifest_version": { "type": "string", "enum": ["1.0.0"] },
    "package_id": { "type": "string" },
    "case_id": { "type": "string" },
    "acquisition_id": { "type": "string" },
    "acquisition_method": {
      "type": "string",
      "enum": [
        "local_system_authorized",
        "remote_agent_connected",
        "offline_field_collector",
        "controlled_manual_import",
        "synthetic_benchmark"
      ]
    },
    "forenx_version": { "type": "string" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "endpoint_id": { "type": ["string", "null"] },
    "operating_system": { "type": "string" },
    "authorizing_investigator": { "type": "string" },
    "acquisition_notes": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "browser_family",
          "profile_label",
          "artifact_type",
          "relative_path",
          "byte_size",
          "sha256",
          "acquisition_status"
        ],
        "properties": {
          "artifact_id": { "type": "string" },
          "browser_family": { "type": "string", "enum": ["Chromium", "Firefox", "Generic"] },
          "browser_name": { "type": "string" },
          "profile_label": { "type": "string" },
          "artifact_type": {
            "type": "string",
            "enum": ["History", "Bookmarks", "places.sqlite", "download_metadata"]
          },
          "relative_path": { "type": "string" },
          "byte_size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sidecars_preserved": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acquisition_status": {
            "type": "string",
            "enum": ["acquired", "partial", "failed", "locked"]
          },
          "parser_compatibility": { "type": "string" },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
